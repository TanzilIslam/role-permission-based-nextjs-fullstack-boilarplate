# Neon Postgres. Both come from `neonctl connection-string` (or the Neon console).
#
# Pooled endpoint (host contains "-pooler") — used by the app at runtime.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Direct/unpooled endpoint — required by `prisma migrate`, because PgBouncer
# cannot hold the session state that DDL and advisory locks need.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Password for the seeded super-admin account. Set this before seeding anywhere
# that is not a throwaway dev database.
SEED_ADMIN_PASSWORD=
